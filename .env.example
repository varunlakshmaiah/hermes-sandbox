# `./hermes setup` creates .env and asks for these. Only one provider is required.

# Provider option 1 — OpenAI (default):
OPENAI_API_KEY=your_openai_api_key_here

# Provider option 2 — any OpenAI-compatible API (OpenRouter, Groq, Together, Ollama, ...):
# set its base URL, key (optional for local servers) and a model name it offers.
# Servers on this computer: use http://host.docker.internal:<port>/v1, not localhost.
LLM_BASE_URL=
LLM_API_KEY=

# Model name. Optional for OpenAI (default gpt-4.1-mini); required with LLM_BASE_URL.
HERMES_MODEL=

# Optional: leave empty to generate a persistent API key (`./hermes key` shows it).
# If supplied, use a unique random value of at least 32 characters.
API_SERVER_KEY=
# Optional: Discord bot. Unknown users are denied unless listed here or paired.
DISCORD_BOT_TOKEN=your_discord_token_here_optional
DISCORD_ALLOWED_USERS=
# Optional: host port for the API (bound to 127.0.0.1 only).
HERMES_API_PORT=8000
# Optional: pin a release (e.g. v0.2.0) instead of the latest tested images.
HERMES_SANDBOX_VERSION=latest
