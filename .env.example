# This is the only file you need to edit. Copy it to .env and add your API key.
OPENAI_API_KEY=your_openai_api_key_here
DISCORD_BOT_TOKEN=your_discord_token_here_optional

# Optional: comma-separated Discord user IDs allowed to talk to your bot.
DISCORD_ALLOWED_USERS=
# Optional: OpenAI model available to your account.
HERMES_MODEL=gpt-4.1-mini
# Optional: leave empty to automatically generate a persistent API bearer token.
# If supplied, use a unique, random value of at least 32 characters.
API_SERVER_KEY=
# Optional: pin a tested upstream image tag or digest for controlled upgrades.
HERMES_IMAGE=nousresearch/hermes-agent:latest
