# Only OPENAI_API_KEY is required. `./hermes setup` creates .env and asks for it.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model available to your account.
HERMES_MODEL=gpt-4.1-mini
# Optional: leave empty to generate a persistent API key (`./hermes key` shows it).
# If supplied, use a unique random value of at least 32 characters.
API_SERVER_KEY=
# Optional: Discord bot. Unknown users are denied unless listed here or paired.
DISCORD_BOT_TOKEN=your_discord_token_here_optional
DISCORD_ALLOWED_USERS=
# Optional: host port for the API (bound to 127.0.0.1 only).
HERMES_API_PORT=8000
# Optional: pin a release (e.g. v0.2.0) instead of the latest tested images.
HERMES_SANDBOX_VERSION=latest
